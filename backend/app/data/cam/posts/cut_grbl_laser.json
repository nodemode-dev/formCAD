{
 "id": "cut_grbl_laser",
 "name": "grbl laser cutting",
 "version": 1,
 "extension": ".nc",
 "description": "grbl 1.1 in laser mode for cutting contours: the process on word is M4 S<power> (dynamic power, scales with speed in the corners), off is M5, G0 never fires the laser. A first version written from the grbl laser mode page; the pierce dwell is a plain G4 and the laser stays on during it only if your firmware allows, so keep the pierce delay at zero for diode lasers.",
 "caps": {
  "arcs": true,
  "helix": false,
  "cycles": [],
  "cutter_comp": false,
  "tool_length": false,
  "tool_change": false,
  "wcs": [1, 2, 3, 4, 5, 6],
  "rotary": false,
  "planes": true,
  "line_numbers": false,
  "feed_modal": true,
  "laser": true
 },
 "number": {"decimals": 3, "arc_decimals": 4, "trim": true},
 "axes": {"x": "X", "y": "Y", "z": "Z", "a": "A", "b": "B", "c": "C"},
 "wcs_codes": ["G54", "G55", "G56", "G57", "G58", "G59"],
 "units_codes": {"mm": "G21", "in": "G20"},
 "templates": {
  "header": ["({program})", "[(Generated {date})]", "(Laser mode needs $32=1 on the controller)", "{units_code} G90 G17 G94 G40", "M5"],
  "footer": ["M5", "M2"],
  "spindle_cw": "M4 S{rpm}",
  "spindle_ccw": "M3 S{rpm}",
  "spindle_off": "M5",
  "rapid": "G0 {pos}",
  "feed": "G1 {pos}[ F{f}]",
  "arc_cw": "G2 {pos}[ I{i}][ J{j}][ F{f}]",
  "arc_ccw": "G3 {pos}[ I{i}][ J{j}][ F{f}]",
  "dwell": "G4 P{seconds}",
  "wcs": "{code}",
  "comment": "({text})",
  "stop_optional": "M1",
  "stop_hard": "M0",
  "plane_xy": "G17",
  "plane_zx": "G18",
  "plane_yz": "G19"
 }
}
