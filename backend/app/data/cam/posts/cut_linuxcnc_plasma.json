{
 "id": "cut_linuxcnc_plasma",
 "name": "LinuxCNC plasma cutting",
 "version": 1,
 "extension": ".ngc",
 "description": "LinuxCNC contour cutting with the torch on as M3 and off as M5, the pierce delay as G4, torch height as plain Z moves (pierce height, then cut height). Torch height control, arc voltage and arc ok signals are machine specific and are not written; edit the templates of a copy for your table.",
 "caps": {
  "arcs": true,
  "helix": true,
  "cycles": [],
  "cutter_comp": false,
  "tool_length": false,
  "tool_change": false,
  "wcs": [1, 2, 3, 4, 5, 6, 7, 8, 9],
  "rotary": false,
  "planes": true,
  "line_numbers": false,
  "feed_modal": true,
  "laser": false
 },
 "number": {"decimals": 3, "arc_decimals": 4, "trim": true},
 "axes": {"x": "X", "y": "Y", "z": "Z", "a": "A", "b": "B", "c": "C"},
 "wcs_codes": ["G54", "G55", "G56", "G57", "G58", "G59", "G59.1", "G59.2", "G59.3"],
 "units_codes": {"mm": "G21", "in": "G20"},
 "templates": {
  "header": ["({program})", "[(Generated {date})]", "{units_code} G90 G17 G40 G94"],
  "footer": ["M5", "M2"],
  "spindle_cw": "M3",
  "spindle_ccw": "M3",
  "spindle_off": "M5",
  "rapid": "G0 {pos}",
  "feed": "G1 {pos}[ F{f}]",
  "arc_cw": "G2 {pos}[ I{i}][ J{j}][ F{f}]",
  "arc_ccw": "G3 {pos}[ I{i}][ J{j}][ F{f}]",
  "dwell": "G4 P{seconds}",
  "wcs": "{code}",
  "comment": "({text})",
  "stop_optional": "M1",
  "stop_hard": "M0",
  "plane_xy": "G17",
  "plane_zx": "G18",
  "plane_yz": "G19"
 }
}
