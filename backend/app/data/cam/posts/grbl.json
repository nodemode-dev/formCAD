{
 "id": "grbl",
 "name": "grbl",
 "version": 1,
 "extension": ".nc",
 "description": "grbl 1.1 hobby mill or router: no canned cycles (expanded to moves), no cutter compensation, no tool change (a pause with a message), work offsets G54 to G59 only. Written from the grbl documentation; the dwell word is the common G4 P in seconds and is not confirmed by the pages read, so check it on your controller.",
 "caps": {
  "arcs": true,
  "helix": true,
  "cycles": [],
  "cutter_comp": false,
  "tool_length": false,
  "tool_change": false,
  "wcs": [1, 2, 3, 4, 5, 6],
  "rotary": false,
  "planes": true,
  "line_numbers": false,
  "feed_modal": true,
  "laser": false
 },
 "number": {"decimals": 3, "arc_decimals": 4, "trim": true},
 "axes": {"x": "X", "y": "Y", "z": "Z", "a": "A", "b": "B", "c": "C"},
 "wcs_codes": ["G54", "G55", "G56", "G57", "G58", "G59"],
 "units_codes": {"mm": "G21", "in": "G20"},
 "templates": {
  "header": ["({program})", "{units_code} G90 G17 G94 G40"],
  "footer": ["M5", "M9", "M30"],
  "tool_change": ["M5", "(Change to tool {tool} {name})", "M0"],
  "spindle_cw": "M3 S{rpm}",
  "spindle_ccw": "M4 S{rpm}",
  "spindle_off": "M5",
  "coolant_flood": "M8",
  "coolant_mist": "M7",
  "coolant_off": "M9",
  "rapid": "G0 {pos}",
  "feed": "G1 {pos}[ F{f}]",
  "arc_cw": "G2 {pos}[ I{i}][ J{j}][ K{k}][ F{f}]",
  "arc_ccw": "G3 {pos}[ I{i}][ J{j}][ K{k}][ F{f}]",
  "dwell": "G4 P{seconds}",
  "wcs": "{code}",
  "comment": "({text})",
  "stop_optional": "M1",
  "stop_hard": "M0",
  "plane_xy": "G17",
  "plane_zx": "G18",
  "plane_yz": "G19"
 }
}
