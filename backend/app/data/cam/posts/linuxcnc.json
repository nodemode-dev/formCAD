{
 "id": "linuxcnc",
 "name": "LinuxCNC",
 "version": 1,
 "extension": ".ngc",
 "description": "LinuxCNC mill: canned cycles G81 G82 G83 G73, G41 G42 compensation, G43 tool length, nine work offsets, arcs in all three planes, centre format arcs. Written from the LinuxCNC documentation; check it on your machine before cutting.",
 "caps": {
  "arcs": true,
  "helix": true,
  "cycles": ["drill", "dwell", "peck", "chip"],
  "cutter_comp": true,
  "tool_length": true,
  "tool_change": true,
  "wcs": [1, 2, 3, 4, 5, 6, 7, 8, 9],
  "rotary": false,
  "planes": true,
  "line_numbers": false,
  "feed_modal": true,
  "laser": false
 },
 "number": {"decimals": 3, "arc_decimals": 4, "trim": true},
 "axes": {"x": "X", "y": "Y", "z": "Z", "a": "A", "b": "B", "c": "C"},
 "wcs_codes": ["G54", "G55", "G56", "G57", "G58", "G59", "G59.1", "G59.2", "G59.3"],
 "units_codes": {"mm": "G21", "in": "G20"},
 "templates": {
  "header": ["({program})", "[(Generated {date})]", "{units_code} G90 G17 G40 G49 G94"],
  "footer": ["M5", "M9", "G49", "M30"],
  "tool_change": ["M5", "T{tool} M6", "G43 H{h}"],
  "spindle_cw": "S{rpm} M3",
  "spindle_ccw": "S{rpm} M4",
  "spindle_off": "M5",
  "coolant_flood": "M8",
  "coolant_mist": "M7",
  "coolant_off": "M9",
  "rapid": "G0 {pos}",
  "feed": "G1 {pos}[ F{f}]",
  "arc_cw": "G2 {pos}[ I{i}][ J{j}][ K{k}][ F{f}]",
  "arc_ccw": "G3 {pos}[ I{i}][ J{j}][ K{k}][ F{f}]",
  "dwell": "G4 P{seconds}",
  "cycle_start": "G99",
  "cycle_drill": "G81 X{x} Y{y} Z{z} R{r}[ F{f}]",
  "cycle_dwell": "G82 X{x} Y{y} Z{z} R{r} P{p}[ F{f}]",
  "cycle_peck": "G83 X{x} Y{y} Z{z} R{r} Q{q}[ F{f}]",
  "cycle_chip": "G73 X{x} Y{y} Z{z} R{r} Q{q}[ F{f}]",
  "cycle_cancel": "G80",
  "wcs": "{code}",
  "comp_left": "G41 D{d}",
  "comp_right": "G42 D{d}",
  "comp_off": "G40",
  "comment": "({text})",
  "stop_optional": "M1",
  "stop_hard": "M0",
  "plane_xy": "G17",
  "plane_zx": "G18",
  "plane_yz": "G19"
 }
}
