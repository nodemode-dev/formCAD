{
 "id": "millturn_linuxcnc",
 "name": "LinuxCNC mill-turn",
 "version": 1,
 "extension": ".ngc",
 "description": "LinuxCNC lathe with a C axis and live tools: turning operations as in the LinuxCNC lathe post (G7, G95, G96, G33), live tool drilling as X Z C moves with feed per minute (G94) and the spindle word of the live tool. The C axis index, mode change codes and live tool spindle codes differ between machines; put yours in the machine mode lines. A first version written from the LinuxCNC lathe pages; check it on your machine before cutting.",
 "caps": {
  "arcs": true,
  "helix": false,
  "cycles": [],
  "cutter_comp": false,
  "tool_length": true,
  "tool_change": true,
  "wcs": [1, 2, 3, 4, 5, 6, 7, 8, 9],
  "rotary": false,
  "planes": true,
  "line_numbers": false,
  "feed_modal": true,
  "laser": false
 },
 "number": {"decimals": 3, "arc_decimals": 4, "trim": true},
 "axes": {"x": "X", "y": "Y", "z": "Z", "a": "A", "b": "B", "c": "C"},
 "wcs_codes": ["G54", "G55", "G56", "G57", "G58", "G59", "G59.1", "G59.2", "G59.3"],
 "units_codes": {"mm": "G21", "in": "G20"},
 "templates": {
  "header": ["({program})", "[(Generated {date})]", "{units_code} G90 G18 G95 G40"],
  "footer": ["M5", "G49", "M30"],
  "tool_change": ["M5", "T{tool} M6", "G43 H{h}"],
  "spindle_cw": "G97 S{rpm} M3",
  "spindle_ccw": "G97 S{rpm} M4",
  "spindle_off": "M5",
  "coolant_flood": "M8",
  "coolant_mist": "M7",
  "coolant_off": "M9",
  "rapid": "G0 {pos}",
  "feed": "G1 {pos}[ F{f}]",
  "arc_cw": "G2 {pos}[ I{i}][ J{j}][ K{k}][ F{f}]",
  "arc_ccw": "G3 {pos}[ I{i}][ J{j}][ K{k}][ F{f}]",
  "dwell": "G4 P{seconds}",
  "wcs": "{code}",
  "comment": "({text})",
  "stop_optional": "M1",
  "stop_hard": "M0",
  "plane_xy": "G17",
  "plane_zx": "G18",
  "plane_yz": "G19"
 }
}
