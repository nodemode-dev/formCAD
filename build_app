#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source setup/lib.sh

usage() {
  cat <<'EOF'
./build_app            build the FormCAD desktop app from this folder, start to finish
  --no-install         macOS: leave the built app where it is instead of copying it to Applications
  --install            Linux: install the built .deb with apt (asks for your password)
  --open               open the app when the build is done
  --clean              rebuild the Rust side and the frozen engine from nothing
  --config FILE        extra Tauri configuration, passed to tauri build exactly as given
Every step's output goes to build_app.log beside this file.
EOF
}

install_app=auto open_app=0 clean=0
cfg=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-install) install_app=no ;;
    --install) install_app=yes ;;
    --open) open_app=1 ;;
    --clean) clean=1 ;;
    --config)
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      cfg+=(--config "$2")
      shift ;;
    --config=*) cfg+=("$1") ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

log="$FORMCAD_ROOT/build_app.log"
: > "$log"
exec > >(tee -a "$log") 2>&1
trap 'status=$?; [ $status -eq 0 ] || printf "\n[formCAD] the build stopped (exit %s). The full log is %s\n" "$status" "$log"' EXIT

os="$(fc_os)"
step() { printf '\n[formCAD] == %s\n' "$*"; }

step "checking the tools"
[ "$os" = macos ] || [ "$os" = linux ] || fc_die "build_app runs on macOS and Linux; on Windows run build_app.bat"
if [ "$os" = macos ]; then
  xcode-select -p >/dev/null 2>&1 || fc_die "the Xcode command line tools are missing: run xcode-select --install, then ./build_app again"
fi
py="$(fc_python)" || fc_die "Python 3.12 or newer is required"
fc_node_ok || fc_die "Node 22 or newer is required"
fc_rust_env
if ! command -v rustup >/dev/null 2>&1 && ! command -v cargo >/dev/null 2>&1; then
  fc_say "installing Rust with rustup (https://rustup.rs) into ~/.cargo; your shell profile is not changed"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
  fc_rust_env
fi
if command -v rustup >/dev/null 2>&1; then
  rustup toolchain list | grep -q '^stable' || rustup toolchain install stable --profile minimal
  fc_rust_env
fi
command -v rustc >/dev/null 2>&1 && command -v cargo >/dev/null 2>&1 || fc_die "Rust is missing; install it from https://rustup.rs"
[ "$(dirname "$(command -v rustc)")" = "$(dirname "$(command -v cargo)")" ] \
  || fc_die "rustc ($(command -v rustc)) and cargo ($(command -v cargo)) come from different installs; remove one and run ./build_app again"
if [ "$os" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  fc_die "Tauri needs system libraries; on Debian or Ubuntu: sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf"
fi
version="$("$py" -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' src-tauri/tauri.conf.json)"
fc_say "building FormCAD $version from $(pwd)"
fc_say "python $("$py" -c 'import platform; print(platform.python_version())'), node $(node -v), $(rustc -V), $(cargo -V | awk '{print $1, $2}')"

step "installing the engine and the window"
{ [ -f backend/venv/bin/activate ] && [ -d frontend/node_modules ]; } || setup/install_all --lite
step "installing the desktop packages (PyInstaller, the Tauri command line)"
setup/install_desktop

[ -z "${FORMCAD_CARGO_TARGET:-}" ] || export CARGO_TARGET_DIR="$FORMCAD_CARGO_TARGET"

if [ "$clean" = 1 ]; then
  step "cleaning earlier builds"
  ( cd src-tauri && cargo clean )
  rm -rf backend/build/pyinstaller backend/dist-engine src-tauri/engine
fi
fc_rust_fresh

step "building the window"
setup/build_frontend
step "freezing the engine"
setup/freeze_backend
if [ ! -f src-tauri/icons/icon.icns ] && [ -f assets/formcad_icon.png ]; then
  frontend/node_modules/.bin/tauri icon assets/formcad_icon.png -o src-tauri/icons
fi

tauri_args=(build)
case "$os" in
  macos)
    tauri_args+=(--bundles "${FORMCAD_BUNDLES:-app}")
    [ -n "${APPLE_SIGNING_IDENTITY:-}" ] || tauri_args+=(--config '{"bundle":{"macOS":{"signingIdentity":"-"}}}')
    ;;
  linux) [ -z "${FORMCAD_BUNDLES:-}" ] || tauri_args+=(--bundles "$FORMCAD_BUNDLES") ;;
esac
tauri_args+=(${cfg[@]+"${cfg[@]}"})

step "building the desktop app (the first build compiles several hundred Rust crates)"
frontend/node_modules/.bin/tauri "${tauri_args[@]}"

bundle="${CARGO_TARGET_DIR:-$FORMCAD_ROOT/src-tauri/target}/release/bundle"

if [ "$os" = macos ]; then
  app="$bundle/macos/FormCAD.app"
  [ -d "$app" ] || fc_die "the build finished but $app is missing"
  codesign --verify --deep --strict "$app" 2>/dev/null || fc_say "codesign could not verify the app; it is ad hoc signed, so macOS may ask once before it opens"
  if [ ! -f "$bundle/macos/FormCAD.app.tar.gz" ]; then
    tar -C "$bundle/macos" -czf "$bundle/macos/FormCAD.app.tar.gz" FormCAD.app
  fi
  step "packing the disk image"
  mkdir -p "$bundle/dmg"
  dmg="$bundle/dmg/FormCAD_${version}_$(uname -m).dmg"
  stage="$(mktemp -d)"
  ditto "$app" "$stage/FormCAD.app"
  ln -s /Applications "$stage/Applications"
  rm -f "$dmg"
  hdiutil create -quiet -volname FormCAD -srcfolder "$stage" -ov -format UDZO "$dmg"
  rm -rf "$stage"
  fc_say "app: $app"
  fc_say "disk image: $dmg"
  target_app=""
  if [ "$install_app" = auto ] || [ "$install_app" = yes ]; then
    dest=/Applications
    [ -w "$dest" ] || { dest="$HOME/Applications"; mkdir -p "$dest"; }
    if pgrep -x FormCAD >/dev/null 2>&1; then
      osascript -e 'tell application "FormCAD" to quit' >/dev/null 2>&1 || true
      sleep 2
    fi
    rm -rf "$dest/FormCAD.app"
    ditto "$app" "$dest/FormCAD.app"
    xattr -dr com.apple.quarantine "$dest/FormCAD.app" 2>/dev/null || true
    target_app="$dest/FormCAD.app"
    fc_say "installed: $target_app"
  fi
  if [ "$open_app" = 1 ]; then open "${target_app:-$app}"; fi
else
  deb="$(ls -t "$bundle"/deb/*.deb 2>/dev/null | head -1 || true)"
  [ -z "$deb" ] || fc_say "package: $deb"
  ls "$bundle"/*/ 2>/dev/null | sed 's/^/  /' || true
  if [ "$install_app" = yes ] && [ -n "$deb" ]; then
    sudo apt install -y "$deb"
  elif [ -n "$deb" ]; then
    fc_say "install it with: sudo apt install $deb   (or run ./build_app --install)"
  fi
  if [ "$open_app" = 1 ]; then
    "${CARGO_TARGET_DIR:-$FORMCAD_ROOT/src-tauri/target}/release/formcad" >/dev/null 2>&1 &
  fi
fi
fc_say "done in ${SECONDS}s"
