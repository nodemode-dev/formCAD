#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const os = require('node:os');
const net = require('node:net');
const path = require('node:path');
const http = require('node:http');
const { spawn } = require('node:child_process');
const { pathToFileURL } = require('node:url');

const REPO = path.resolve(__dirname, '..', '..');
const FRONTEND = path.join(REPO, 'frontend');
const BACKEND = path.join(REPO, 'backend');

const USAGE = `usage: demo/tools/record --doc <path.fcad> --out <recording.json> [options]

  --doc <path>         document to open in the engine (required)
  --out <file>         recording to write (required)
  --steps <list>       comma list of view steps after boot: pick, clear, dock, palette, layers (default all)
  --picks <n>          objects of distinct kinds to click in the pick step (default 8)
  --script <file.mjs>  a module whose default export runs more steps after the built-in ones;
                       it gets { cdp, click, key, rects, idle, sleep, log }
  --size <WxH>         window size (default 1440x900)
  --screenshot <png>   also save a screenshot of the recorded window
  --chrome <bin>       browser binary (default google-chrome)
  --python <bin>       engine interpreter (default backend/venv/bin/python)
  --idle <ms>          quiet time that ends a step (default 1500)`;

function args(argv) {
  const out = { steps: 'pick,clear,dock,palette,layers', size: '1440x900', chrome: 'google-chrome', python: path.join(BACKEND, 'venv', 'bin', 'python'), idle: 1500 };
  for (let i = 0; i < argv.length; i++) {
    const k = argv[i];
    if (k === '-h' || k === '--help') { console.log(USAGE); process.exit(0); }
    if (!k.startsWith('--') || i + 1 >= argv.length) { console.error(USAGE); process.exit(2); }
    out[k.slice(2)] = argv[++i];
  }
  if (!out.doc || !out.out) { console.error(USAGE); process.exit(2); }
  out.doc = path.resolve(out.doc);
  out.out = path.resolve(out.out);
  if (out.script) out.script = path.resolve(out.script);
  if (out.screenshot) out.screenshot = path.resolve(out.screenshot);
  out.idle = Number(out.idle) || 1500;
  const [w, h] = out.size.split('x').map(Number);
  out.width = w || 1440;
  out.height = h || 900;
  if (!fs.existsSync(out.doc)) { console.error(`no such document: ${out.doc}`); process.exit(2); }
  return out;
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const log = (msg) => process.stderr.write(`record: ${msg}\n`);

function freePort() {
  return new Promise((resolve, reject) => {
    const s = net.createServer();
    s.once('error', reject);
    s.listen(0, '127.0.0.1', () => { const { port } = s.address(); s.close(() => resolve(port)); });
  });
}

function request(method, url, headers = {}, body) {
  return new Promise((resolve, reject) => {
    const req = http.request(url, { method, headers }, (res) => {
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => resolve({ status: res.statusCode, text: Buffer.concat(chunks).toString('utf8') }));
    });
    req.on('error', reject);
    if (body !== undefined) req.write(body);
    req.end();
  });
}

async function until(what, fn, timeout = 60000, every = 250) {
  const end = Date.now() + timeout;
  for (;;) {
    try { const v = await fn(); if (v) return v; } catch { }
    if (Date.now() > end) throw new Error(`timed out waiting for ${what}`);
    await sleep(every);
  }
}

class Cdp {
  constructor(url) {
    this.seq = 0;
    this.pending = new Map();
    this.handlers = new Map();
    this.ws = new WebSocket(url);
    this.ready = new Promise((resolve, reject) => { this.ws.onopen = resolve; this.ws.onerror = reject; });
    this.ws.onmessage = (m) => {
      const msg = JSON.parse(String(m.data));
      if (msg.id && this.pending.has(msg.id)) {
        const { resolve, reject } = this.pending.get(msg.id);
        this.pending.delete(msg.id);
        if (msg.error) reject(new Error(msg.error.message)); else resolve(msg.result);
      } else if (msg.method) {
        for (const fn of this.handlers.get(msg.method) ?? []) fn(msg.params);
      }
    };
  }
  send(method, params = {}) {
    const id = ++this.seq;
    this.ws.send(JSON.stringify({ id, method, params }));
    return new Promise((resolve, reject) => this.pending.set(id, { resolve, reject }));
  }
  on(method, fn) {
    if (!this.handlers.has(method)) this.handlers.set(method, []);
    this.handlers.get(method).push(fn);
  }
  async eval(expression) {
    const r = await this.send('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true });
    return r.result?.value;
  }
  close() { try { this.ws.close(); } catch { } }
}

async function viteServer(enginePort, dataDir, port) {
  const pkg = JSON.parse(fs.readFileSync(path.join(FRONTEND, 'node_modules', 'vite', 'package.json'), 'utf8'));
  const entry = typeof pkg.exports['.'] === 'string' ? pkg.exports['.'] : pkg.exports['.'].import?.default ?? pkg.exports['.'].import ?? pkg.exports['.'].default;
  const vite = await import(pathToFileURL(path.join(FRONTEND, 'node_modules', 'vite', entry)).href);
  process.env.FORMCAD_BACKEND_PORT = String(enginePort);
  process.env.FORMCAD_DATA_DIR = dataDir;
  process.chdir(FRONTEND);
  const server = await vite.createServer({ configFile: path.join(FRONTEND, 'vite.config.ts'), logLevel: 'error', clearScreen: false, server: { port, strictPort: true, host: '127.0.0.1', hmr: false } });
  await server.listen();
  return { server, port };
}

async function main() {
  const opt = args(process.argv.slice(2));
  const started = [];
  const temp = fs.mkdtempSync(path.join(os.tmpdir(), 'formcad-record-'));
  const dataDir = path.join(temp, 'data');
  fs.mkdirSync(dataDir);
  let vite = null;
  let cdp = null;
  const stop = async () => {
    cdp?.close();
    for (const p of started.reverse()) { try { process.kill(-p.pid, 'SIGTERM'); } catch { try { p.kill('SIGTERM'); } catch { } } }
    if (vite) await vite.server.close().catch(() => {});
    await sleep(300);
    fs.rmSync(temp, { recursive: true, force: true });
  };
  process.on('SIGINT', () => { void stop().then(() => process.exit(130)); });
  try {
    const enginePort = await freePort();
    const viteHolder = await freePort();
    const engine = spawn(opt.python, ['-m', 'uvicorn', 'app.main:app', '--host', '127.0.0.1', '--port', String(enginePort)], {
      cwd: BACKEND,
      detached: true,
      stdio: ['ignore', 'ignore', fs.openSync(path.join(temp, 'engine.log'), 'w')],
      env: { ...process.env, FORMCAD_DATA_DIR: dataDir, FORMCAD_CORS_ORIGINS: `http://127.0.0.1:${viteHolder},http://localhost:${viteHolder}` },
    });
    started.push(engine);
    const base = `http://127.0.0.1:${enginePort}`;
    const token = await until('the engine token', () => fs.readFileSync(path.join(dataDir, 'session.token'), 'utf8').trim(), 60000);
    const auth = { 'X-FormCAD-Token': token };
    const health = JSON.parse((await until('the engine', async () => { const r = await request('GET', `${base}/api/health`, auth); return r.status === 200 && r; }, 60000)).text);
    log(`engine ${health.version} on ${enginePort}`);
    const opened = await request('POST', `${base}/api/docs/open`, { ...auth, 'Content-Type': 'application/json' }, JSON.stringify({ path: opt.doc }));
    if (opened.status !== 200) throw new Error(`the engine could not open ${opt.doc}: ${opened.text}`);
    const doc = JSON.parse(opened.text);
    log(`opened ${doc.name} as ${doc.id}`);

    vite = await viteServer(enginePort, dataDir, viteHolder);
    const page = `http://127.0.0.1:${vite.port}/`;
    log(`interface on ${vite.port}`);

    const debugPort = await freePort();
    const chrome = spawn(opt.chrome, ['--headless=new', '--no-sandbox', '--disable-gpu', '--hide-scrollbars', '--no-first-run', '--no-default-browser-check', `--remote-debugging-port=${debugPort}`, `--user-data-dir=${path.join(temp, 'chrome')}`, `--window-size=${opt.width},${opt.height}`, 'about:blank'], { detached: true, stdio: 'ignore' });
    started.push(chrome);
    const target = await until('the browser', async () => {
      const r = await request('GET', `http://127.0.0.1:${debugPort}/json/list`);
      return JSON.parse(r.text).find((t) => t.type === 'page');
    }, 30000);
    cdp = new Cdp(target.webSocketDebuggerUrl);
    await cdp.ready;

    const t0 = Date.now();
    let phase = 'boot';
    let last = Date.now();
    const live = new Map();
    const exchanges = [];
    const frames = [];
    const sockets = new Set();
    const errors = [];
    const ours = (url) => { try { return new URL(url).pathname.startsWith('/api/'); } catch { return false; } };

    cdp.on('Network.requestWillBeSent', (p) => {
      if (!ours(p.request.url) || p.type === 'WebSocket') return;
      last = Date.now();
      const u = new URL(p.request.url);
      const ex = { seq: exchanges.length, t: Date.now() - t0, phase, method: p.request.method, path: u.pathname, query: u.search.replace(/^\?/, ''), body: p.request.postData ?? null, status: 0, type: '', response: null, encoding: 'text' };
      exchanges.push(ex);
      live.set(p.requestId, { ex, needsBody: p.request.hasPostData && p.request.postData === undefined });
    });
    cdp.on('Network.responseReceived', (p) => {
      const rec = live.get(p.requestId);
      if (!rec) return;
      rec.ex.status = p.response.status;
      rec.ex.type = p.response.mimeType || '';
    });
    const settle = async (p, failed) => {
      const rec = live.get(p.requestId);
      if (!rec) return;
      try {
        if (rec.needsBody) rec.ex.body = (await cdp.send('Network.getRequestPostData', { requestId: p.requestId })).postData;
        if (!failed && rec.ex.status !== 204) {
          const b = await cdp.send('Network.getResponseBody', { requestId: p.requestId });
          rec.ex.response = b.body;
          rec.ex.encoding = b.base64Encoded ? 'base64' : 'text';
        }
      } catch (e) {
        rec.ex.error = String(e.message || e);
      }
      live.delete(p.requestId);
      last = Date.now();
    };
    cdp.on('Network.loadingFinished', (p) => { void settle(p, false); });
    cdp.on('Network.loadingFailed', (p) => { const rec = live.get(p.requestId); if (rec) rec.ex.error = p.errorText; void settle(p, true); });
    cdp.on('Network.webSocketCreated', (p) => { if (ours(p.url)) sockets.add(p.requestId); });
    cdp.on('Network.webSocketFrameReceived', (p) => {
      if (!sockets.has(p.requestId) || p.response.opcode !== 1) return;
      last = Date.now();
      frames.push({ t: Date.now() - t0, phase, data: p.response.payloadData });
    });
    cdp.on('Runtime.exceptionThrown', (p) => errors.push(p.exceptionDetails?.exception?.description || p.exceptionDetails?.text || 'exception'));

    await cdp.send('Network.enable', { maxResourceBufferSize: 64 * 1024 * 1024, maxTotalBufferSize: 256 * 1024 * 1024 });
    await cdp.send('Runtime.enable');
    await cdp.send('Page.enable');
    await cdp.send('Emulation.setDeviceMetricsOverride', { width: opt.width, height: opt.height, deviceScaleFactor: 1, mobile: false });
    await cdp.send('Page.navigate', { url: page });

    const idle = async (label) => {
      await until(`a quiet interface (${label})`, () => live.size === 0 && Date.now() - last > opt.idle, 60000, 100);
    };
    await until('the window', () => cdp.eval(`document.body.classList.contains('app-ready') && !!document.querySelector('.cv-canvas-host canvas')`), 90000);
    await idle('boot');
    log(`boot: ${exchanges.length} requests, ${frames.length} frames`);

    const click = async (x, y) => {
      for (const type of ['mouseMoved', 'mousePressed', 'mouseReleased']) {
        await cdp.send('Input.dispatchMouseEvent', { type, x, y, button: type === 'mouseMoved' ? 'none' : 'left', clickCount: 1 });
        await sleep(40);
      }
    };
    const key = async (keyName, code, keyCode, modifiers = 0) => {
      await cdp.send('Input.dispatchKeyEvent', { type: 'keyDown', key: keyName, code, windowsVirtualKeyCode: keyCode, modifiers });
      await cdp.send('Input.dispatchKeyEvent', { type: 'keyUp', key: keyName, code, windowsVirtualKeyCode: keyCode, modifiers });
    };
    const rects = (selector) => cdp.eval(`[...document.querySelectorAll(${JSON.stringify(selector)})].filter((n) => n.offsetParent).map((n) => { const r = n.getBoundingClientRect(); return [r.x + r.width / 2, r.y + r.height / 2]; })`);

    const steps = new Set(String(opt.steps).split(',').map((s) => s.trim()).filter(Boolean));
    phase = 'views';
    if (steps.has('pick')) {
      const hit = await cdp.eval(`(() => { const c = document.querySelector('.cv-canvas-host canvas'); const r = c.getBoundingClientRect(); return [r.x, r.y, r.width, r.height]; })()`);
      if (hit) {
        const [x, y, w, h] = hit;
        const picks = await cdp.eval(`(() => { try {
          const c = window.formcadCanvas; const seen = new Set(); const out = [];
          for (const it of c.store.items.values()) {
            if (it.h === null || seen.has(it.kind) || out.length >= ${Number(opt.picks) || 8}) continue;
            const g = it.grips && it.grips[0]; const gp = g && (g.p || g.at || (Array.isArray(g) ? g : null));
            const b = it.bounds; const wp = gp && gp.length >= 2 ? gp : [(b[0] + b[2]) / 2, (b[1] + b[3]) / 2];
            const s = c.cam.toScreen(wp[0], wp[1]);
            if (s[0] < 4 || s[1] < 4 || s[0] > ${w} - 4 || s[1] > ${h} - 4) continue;
            seen.add(it.kind); out.push([s[0], s[1]]);
          }
          return out;
        } catch (e) { return []; } })()`) || [];
        const points = picks.length ? picks.map(([px, py]) => [x + px, y + py]) : [[0.5, 0.5], [0.35, 0.4], [0.65, 0.6]].map(([fx, fy]) => [x + w * fx, y + h * fy]);
        for (const [px, py] of points) {
          await click(Math.round(px), Math.round(py));
          await idle('pick');
          await key('Escape', 'Escape', 27);
          await idle('pick clear');
        }
        const steps2 = 12;
        const [ax, ay, bx, by] = [x + 6, y + 6, x + w - 6, y + h - 6];
        await cdp.send('Input.dispatchMouseEvent', { type: 'mouseMoved', x: ax, y: ay, button: 'none' });
        await cdp.send('Input.dispatchMouseEvent', { type: 'mousePressed', x: ax, y: ay, button: 'left', clickCount: 1 });
        for (let i = 1; i <= steps2; i++) await cdp.send('Input.dispatchMouseEvent', { type: 'mouseMoved', x: ax + ((bx - ax) * i) / steps2, y: ay + ((by - ay) * i) / steps2, button: 'left', buttons: 1 });
        await cdp.send('Input.dispatchMouseEvent', { type: 'mouseReleased', x: bx, y: by, button: 'left', clickCount: 1 });
        await idle('window select');
        log(`pick: ${points.length} objects and a window`);
      }
    }
    if (steps.has('clear')) { await key('Escape', 'Escape', 27); await idle('clear'); }
    if (steps.has('dock')) {
      const tabs = (await rects('.cv-dock [role="tab"], .cv-dock .cv-dock-tab')) || [];
      for (const [x, y] of tabs) { await click(Math.round(x), Math.round(y)); await idle('dock'); }
    }
    if (steps.has('palette')) {
      await key('p', 'KeyP', 80, 2 | 8);
      await idle('palette');
      await key('Escape', 'Escape', 27);
      await idle('palette close');
    }
    if (steps.has('layers')) {
      const btns = (await rects('[data-cmd="layers"], [data-cmd="layer"]')) || [];
      if (btns.length) { await click(Math.round(btns[0][0]), Math.round(btns[0][1])); await idle('layers'); await key('Escape', 'Escape', 27); await idle('layers close'); }
    }
    if (opt.script) {
      const extra = await import(pathToFileURL(path.resolve(opt.script)).href);
      await extra.default({ cdp, click, key, rects, idle, sleep, log });
      await idle('script');
    }
    if (opt.screenshot) {
      await key('Escape', 'Escape', 27);
      await idle('shot');
      const shot = await cdp.send('Page.captureScreenshot', { format: 'png' });
      fs.mkdirSync(path.dirname(path.resolve(opt.screenshot)), { recursive: true });
      fs.writeFileSync(path.resolve(opt.screenshot),Buffer.from(shot.data, 'base64'));
    }

    const responses = [];
    const seen = new Map();
    const kept = exchanges.filter((e) => e.status > 0).map((e, seq) => {
      let r = null;
      if (e.response !== null) {
        const k = `${e.encoding}:${e.response}`;
        if (!seen.has(k)) { seen.set(k, responses.length); responses.push(e.response); }
        r = seen.get(k);
      }
      const { response: _drop, ...rest } = e;
      return { ...rest, seq, response: r };
    });
    const recording = {
      format: 'formcad-replay',
      version: 1,
      recorded: new Date().toISOString(),
      engine: health.version,
      document: { file: path.basename(opt.doc), id: doc.id, name: doc.name },
      window: { width: opt.width, height: opt.height },
      steps: [...steps],
      exchanges: kept,
      responses,
      frames,
    };
    fs.mkdirSync(path.dirname(opt.out), { recursive: true });
    const neutral = [[path.dirname(opt.doc), '/demo'], [temp, '/demo/data'], [REPO, '/demo/formCAD']];
    fs.writeFileSync(opt.out, neutral.reduce((text, [from, to]) => text.split(from).join(to), JSON.stringify(recording)));
    const size = fs.statSync(opt.out).size;
    log(`wrote ${opt.out}: ${recording.exchanges.length} exchanges, ${frames.length} frames, ${(size / 1024).toFixed(0)} KiB`);
    if (errors.length) log(`page errors while recording:\n  ${errors.join('\n  ')}`);
  } finally {
    await stop();
  }
}

main().catch((e) => { console.error(`record: ${e.stack || e}`); process.exit(1); });
