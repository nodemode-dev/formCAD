{
  "format": "formcad.graph.matching-corpus",
  "version": 1,
  "source": "research R21 section 2.3 (47 cases M01 to M47), decisions D1 to D9 of section 2.2",
  "notation": "trees are written {path}:[items] branches separated by spaces; <empty> is a tree without branches; numbers compare with absolute tolerance 1e-9",
  "operations": {
    "ADD": "A + B, both item access",
    "ADD3": "A + B + C, all item access",
    "PAIR": "the text A~B, both item access",
    "LJOIN": "list access A and B, returns the concatenation of the two branches (a list)",
    "ADDSUM": "A item plus the sum of B list",
    "ADDCNT": "A item plus the total item count of the tree T",
    "TCOUNT": "the item count of the tree T, one item at {0}",
    "DUP2": "A item, returns the list [A, A] (one to many)"
  },
  "settings": {"cross_scope": "items", "principal_rule": "extreme"},
  "cases": [
    {"id": "M01", "source": "DOC-INTRO, DOC-AU", "op": "ADD", "mode": "longest", "inputs": [{"name": "A", "access": "item", "tree": "{0}:[1,2]"}, {"name": "B", "access": "item", "tree": "{0}:[10,20,30]"}], "principal": null, "expected": "{0}:[11,22,32]", "warnings": [], "note": ""},
