{
  "format": "formcad.graph.tree-ops-corpus",
  "version": 1,
  "source": "research R21 section 1.8 (T, S, PM and P series)",
  "notation": "trees are written {path}:[items] branches separated by spaces; <empty> is a tree without branches; numbers compare with absolute tolerance 1e-9; error cases expect an empty result and the named error code",
  "cases": [
    {"id": "T01", "source": "DOC-ADV", "op": "flatten", "args": {}, "input": "{0}:[a,b] {1}:[c] {2}:[d,e]", "expected": "{0}:[a,b,c,d,e]", "error": null, "warnings": [], "note": ""},
    {"id": "T02", "source": "DERIVED", "op": "flatten", "args": {}, "input": "{1}:[z] {0;1}:[b] {0;0}:[a] {0}:[o]", "expected": "{0}:[o,a,b,z]", "error": null, "warnings": [], "note": "sorted traversal"},
    {"id": "T03", "source": "DOC-MODS (input exists), DERIVED (effect)", "op": "flatten", "args": {"path": "{4;2}"}, "input": "{0}:[a] {1}:[b]", "expected": "{4;2}:[a,b]", "error": null, "warnings": [], "note": "target path input"},
    {"id": "T04", "source": "DOC-ADV", "op": "graft", "args": {}, "input": "{0}:[a,b,c]", "expected": "{0;0}:[a] {0;1}:[b] {0;2}:[c]", "error": null, "warnings": [], "note": ""},
    {"id": "T05", "source": "DOC-ADV", "op": "graft", "args": {}, "input": "{0}:[a,b] {1}:[c]", "expected": "{0;0}:[a] {0;1}:[b] {1;0}:[c]", "error": null, "warnings": [], "note": ""},
    {"id": "T06", "source": "DERIVED", "op": "graft", "args": {}, "input": "{0}:[a,null] {1}:[]", "expected": "{0;0}:[a] {0;1}:[null]", "error": null, "warnings": [], "note": "empty branch vanishes"},
    {"id": "T07", "source": "DOC-ADV, DERIVED", "op": "simplify", "args": {}, "input": "{0;0;0}:[a] {0;0;1}:[b] {0;0;2}:[c]", "expected": "{0}:[a] {1}:[b] {2}:[c]", "error": null, "warnings": [], "note": ""},
    {"id": "T08", "source": "DERIVED", "op": "simplify", "args": {}, "input": "{0;0}:[a] {0;1}:[b] {1;0}:[c]", "expected": "{0;0}:[a] {0;1}:[b] {1;0}:[c]", "error": null, "warnings": [], "note": "no common prefix"},
    {"id": "T09", "source": "DERIVED", "op": "simplify", "args": {}, "input": "{5;3}:[a,b]", "expected": "{3}:[a,b]", "error": null, "warnings": [], "note": "keeps one integer"},
    {"id": "T10", "source": "DERIVED", "op": "simplify", "args": {}, "input": "{0;1}:[a] {0;1;2}:[b]", "expected": "{1}:[a] {1;2}:[b]", "error": null, "warnings": [], "note": "min depth caps removal"},
    {"id": "T11", "source": "DOC-ADV", "op": "flip_matrix", "args": {}, "input": "{0}:[a,b,c,d] {1}:[e,f,g,h]", "expected": "{0}:[a,e] {1}:[b,f] {2}:[c,g] {3}:[d,h]", "error": null, "warnings": [], "note": ""},
    {"id": "T12", "source": "DOC-ADV", "op": "flip_matrix", "args": {}, "input": "{0}:[a,b,c] {1}:[d]", "expected": "{0}:[a,d] {1}:[b,null] {2}:[c,null]", "error": null, "warnings": [], "note": "null padding"},
    {"id": "T13", "source": "DOC-ADV (fails), DERIVED (output)", "op": "flip_matrix", "args": {}, "input": "{0}:[a] {1;0}:[b]", "expected": "<empty>", "error": "FLIP_VARIABLE_DEPTH", "warnings": [], "note": "Error FLIP_VARIABLE_DEPTH"},
    {"id": "T14", "source": "DOC-MODS rule, DERIVED", "op": "flip_tree", "args": {"position": 0}, "input": "{0;0}:[a,b] {1;0}:[c,d]", "expected": "{0;0}:[a,c] {1;0}:[b,d]", "error": null, "warnings": [], "note": "collisions append in traversal order"},
    {"id": "T15", "source": "DOC-MODS rule", "op": "flip_tree", "args": {"position": 0}, "input": "{3;1}:[x,y]", "expected": "{0;1}:[x] {1;1}:[y]", "error": null, "warnings": [], "note": "item at {3;1} index 1 goes to {1;1}"},
    {"id": "T15b", "source": "DOC-MODS rule", "op": "flip_tree", "args": {"position": 1}, "input": "{3;1}:[x,y]", "expected": "{3;0}:[x] {3;1}:[y]", "error": null, "warnings": [], "note": ""},
    {"id": "T16", "source": "DERIVED, CONFLICT with the literal documented wording", "op": "trim", "args": {"depth": 1}, "input": "{0;0}:[a] {0;1}:[b] {1;0}:[c]", "expected": "{0}:[a,b] {1}:[c]", "error": null, "warnings": [], "note": "FormCAD reading: cull last N integers, merge equal paths in sorted order; depth clamps so one integer remains"},
    {"id": "T17", "source": "DERIVED", "op": "shift_paths", "args": {"offset": 2, "position": "last"}, "input": "{0}:[a] {1}:[b]", "expected": "{2}:[a] {3}:[b]", "error": null, "warnings": [], "note": "FormCAD op, not the semantics of any other tool"},
    {"id": "T18", "source": "DERIVED", "op": "shift_paths", "args": {"offset": -1, "position": "last"}, "input": "{0}:[a]", "expected": "<empty>", "error": "PATH_NEGATIVE", "warnings": [], "note": "Error PATH_NEGATIVE; no wrap-around, a negative path integer is an error"},
    {"id": "S01", "source": "DERIVED", "op": "sort_paths", "args": {}, "input": ["{0;1}", "{0}", "{1}", "{0;0;0}", "{0;0}", "{10}", "{2}"], "expected": ["{0}", "{0;0}", "{0;0;0}", "{0;1}", "{1}", "{2}", "{10}"], "error": null, "warnings": [], "note": "path order only"},
    {"id": "PM1", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A;B}(i) -> {A;i}(B)"}, "input": "{0;0}:[a,b] {0;1}:[c,d]", "expected": "{0;0}:[a,c] {0;1}:[b,d]", "error": null, "warnings": [], "note": "flip"},
    {"id": "PM2", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A}(i) -> {A;i}(0)"}, "input": "{0}:[a,b] {1}:[c]", "expected": "{0;0}:[a] {0;1}:[b] {1;0}:[c]", "error": null, "warnings": [], "note": "graft preset"},
    {"id": "PM3", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A}(i) -> {0}(*)"}, "input": "{0}:[a,b] {1}:[c]", "expected": "{0}:[a,b,c]", "error": null, "warnings": [], "note": "flatten preset"},
    {"id": "PM4", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A}(i) -> {path_index}(i)"}, "input": "{5}:[a] {9}:[b,c]", "expected": "{0}:[a] {1}:[b,c]", "error": null, "warnings": [], "note": "renumber preset"},
    {"id": "PM5", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A}(i) -> {path_count-1-path_index}(i)"}, "input": "{0}:[a] {1}:[b] {2}:[c]", "expected": "{0}:[c] {1}:[b] {2}:[a]", "error": null, "warnings": [], "note": "reverse preset"},
    {"id": "PM6", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A;B}(i) -> {A}(i)"}, "input": "{0;0}:[a,b] {0;1}:[c]", "expected": "{0}:[a,c,b]", "error": null, "warnings": [], "note": "keys a0 b1 c0, ties by traversal"},
    {"id": "PM7", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A;B}(i) -> {A}(i)"}, "input": "{0;0}:[a] {1}:[z]", "expected": "{0}:[a]", "error": null, "warnings": [{"code": "PATH_PATTERN_MISMATCH", "count": 1}], "note": "Warning PATH_PATTERN_MISMATCH x1"},
    {"id": "PM8", "source": "DERIVED", "op": "path_map", "args": {"mapping": "{A}(i) -> {A}(item_count-1-i)"}, "input": "{0}:[a,b,c]", "expected": "{0}:[c,b,a]", "error": null, "warnings": [], "note": ""},
    {"id": "P01", "source": "DOC-MODS order", "op": "mods", "args": {"expression": "x*10", "flatten": true}, "input": "{0}:[1,2] {1}:[3]", "expected": "{0}:[10,20,30]", "error": null, "warnings": [], "note": "expression first"},
    {"id": "P02", "source": "DOC-MODS order", "op": "mods", "args": {"reverse": true, "graft": true}, "input": "{0}:[a,b,c]", "expected": "{0;0}:[c] {0;1}:[b] {0;2}:[a]", "error": null, "warnings": [], "note": "reverse before graft"},
    {"id": "P03", "source": "DOC-MODS order", "op": "mods", "args": {"flatten": true, "graft": true}, "input": "{0}:[a,b] {1}:[c]", "expected": "{0;0}:[a] {0;1}:[b] {0;2}:[c]", "error": null, "warnings": [], "note": "flatten before graft"},
    {"id": "P04", "source": "DERIVED", "op": "mods", "args": {"graft": true, "simplify": true}, "input": "{0}:[a,b]", "expected": "{0}:[a] {1}:[b]", "error": null, "warnings": [], "note": "graft then simplify"},
    {"id": "P05", "source": "DOC-MODS conflict", "op": "mods", "args": {"flatten": true, "simplify": true}, "input": "{1;0}:[a] {1;1}:[b]", "expected": "{0}:[a,b]", "error": null, "warnings": [], "note": "simplify skipped under flatten"},
    {"id": "P06", "source": "DOC-MODS", "op": "mods", "args": {"null_to": true, "invert": true}, "input": "{0}:[true,null,false]", "expected": "{0}:[false,false,true]", "error": null, "warnings": [], "note": "replace before negate"},
    {"id": "P07", "source": "DOC-MODS conflict", "op": "mods", "args": {"sort": true, "randomise": true}, "input": "{0}:[3,1,2]", "expected": "{0}:[1,2,3]", "error": null, "warnings": [], "note": "randomise skipped"},
    {"id": "P08", "source": "DOC-MODS order", "op": "mods", "args": {"remove_null": true, "remove_empty": true}, "input": "{0}:[null] {1}:[a]", "expected": "{1}:[a]", "error": null, "warnings": [], "note": "null before empty"},
    {"id": "P09", "source": "DERIVED", "op": "mods", "args": {"reverse": true}, "input": "{0}:[1,2] {1}:[3,4,5]", "expected": "{0}:[2,1] {1}:[5,4,3]", "error": null, "warnings": [], "note": "branch order unchanged"}
  ]
}
