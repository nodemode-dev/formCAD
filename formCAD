#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
version() { sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null; }
usage() {
  printf 'FormCAD %s · drafting and modeling\n' "$(version)"
  cat << 'EOF'

usage: ./formCAD [command] [options]

  (none) | boot | dev   boot the engine (8290) and the frontend (5290) together
  install [--lite]      install the engine, the frontend and (without --lite) the kernel dev venv
  install-desktop       install PyInstaller and check the Rust and Tauri toolchain
  install-kernel        create kernel/venv and install kernel/requirements_kernel.txt (development)
  install-mesher        create mesher/venv and install mesher/requirements_mesher.txt (development)
  backend               boot the engine only
  frontend              boot the frontend only
  build                 production build of the frontend into frontend/dist
  serve                 serve the built frontend from the engine on 127.0.0.1:8290
  freeze                freeze the engine (PyInstaller onedir) into src-tauri/engine
  freeze-kernel         freeze the geometry kernel worker into kernel/dist (never bundled into the app)
  freeze-mesher         freeze the mesher worker into mesher/dist (never bundled into the app)
  desktop dev|build     run or bundle the desktop app
  doctor                check the toolchain, installs and ports
  mcp                   the engine's MCP server over stdio
  clean [--all]         remove build output (--all also venvs and node_modules)
  version               the version and build (also --version)
  help                  this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  install-kernel) exec setup/install_kernel "$@" ;;
  install-mesher) exec setup/install_mesher "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  freeze-kernel) exec setup/freeze_kernel "$@" ;;
  freeze-mesher) exec setup/freeze_mesher "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  mcp) exec setup/mcp "$@" ;;
  clean) exec setup/clean "$@" ;;
  version|--version|-V)
    printf 'FormCAD %s' "$(version)"
    commit="$(git rev-parse --short HEAD 2>/dev/null || true)"
    [ -n "$commit" ] && printf ' (%s)' "$commit"
    printf '\n' ;;
  help|-h|--help) usage ;;
  *) printf '[formCAD] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
