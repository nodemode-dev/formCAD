#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$FORMCAD_ROOT"
for p in frontend/dist backend/build backend/dist-engine kernel/build kernel/dist src-tauri/target src-tauri/gen src-tauri/engine build_app.log; do rm -rf "$p"; done
find backend kernel -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
if [ "${1:-}" = "--all" ]; then for p in frontend/node_modules backend/venv kernel/venv; do rm -rf "$p"; done; fi
fc_say "clean"
