#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fc_rust_env
command -v cargo >/dev/null 2>&1 || fc_die "Rust not found; run ./formCAD install-desktop"
[ -x "$FORMCAD_ROOT/src-tauri/engine/formcad-engine$(fc_exe)" ] || "$FORMCAD_ROOT/setup/freeze_backend"
cd "$FORMCAD_ROOT"
exec frontend/node_modules/.bin/tauri dev "$@"
