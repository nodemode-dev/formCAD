#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"

sign_engine() {
  local ent="$FORMCAD_ROOT/src-tauri/entitlements.plist" identity="${APPLE_SIGNING_IDENTITY:--}" f signed=0
  local files=() flags=(--force --options runtime)
  if [ "$identity" = "-" ]; then flags+=(--timestamp=none); else flags+=(--timestamp); fi
  [ -f "$ent" ] && flags+=(--entitlements "$ent")
  while IFS= read -r f; do
    if file -b "$f" | grep -Eq 'Mach-O.*(executable|shared library|bundle)'; then files+=("$f"); fi
  done < <(find "$1" -type f | awk -F/ '{print NF "\t" $0}' | sort -rn | cut -f2-)
  for f in "${files[@]}"; do
    codesign "${flags[@]}" --sign "$identity" "$f"
    signed=$((signed + 1))
  done
  for f in "${files[@]}"; do codesign --verify "$f" || fc_die "engine file failed its signature check: $f"; done
  if [ "$identity" = "-" ]; then fc_say "engine signed ad hoc: $signed Mach-O files"; else fc_say "engine signed: $signed Mach-O files"; fi
}

flatten_engine() {
  local dir="$1" fw="$1/_internal/Python.framework" lib="$1/_internal/Python" link f links=0
  if [ -d "$fw" ]; then
    [ -f "$fw/Python" ] || fc_die "Python.framework has no Python library: $fw"
    rm -f "$lib"
    cp "$fw/Python" "$lib"
    rm -rf "$fw"
    codesign --force --sign - "$lib"
  fi
  while IFS= read -r link; do
    cp -RL "$link" "$link.flat" && rm -f "$link" && mv "$link.flat" "$link"
    links=$((links + 1))
  done < <(find "$dir" -type l)
  [ -z "$(find "$dir" -type l | head -1)" ] || fc_die "engine still holds symbolic links after flattening: $dir"
  f="$(find "$dir" -name '*.framework' | head -1)"
  [ -z "$f" ] || fc_die "engine holds a .framework that cannot ship as Tauri resources: $f"
  while IFS= read -r f; do
    [ "$f" = "$lib" ] && continue
    if file -b "$f" | grep -q 'Mach-O' && otool -L "$f" | grep -q 'Python.framework'; then fc_die "$f links Python.framework, which the engine no longer ships"; fi
  done < <(find "$dir" -type f)
  fc_say "engine flattened: Python library at _internal/Python, $links links replaced by copies"
}

fc_venv
python -c "import PyInstaller" 2>/dev/null || fc_die "PyInstaller missing, run ./formCAD install-desktop"
[ -f "$FORMCAD_ROOT/frontend/dist/index.html" ] || "$FORMCAD_ROOT/setup/build_frontend"
cd "$FORMCAD_ROOT/backend"
sep=":"
[ "$(fc_os)" = windows ] && sep=";"
ext="$(fc_exe)"
src="$(fc_native_path "$FORMCAD_ROOT")"
extra=()
if [ "$(fc_os)" = windows ]; then extra+=(--hidden-import winpty --collect-binaries winpty); else extra+=(--hidden-import ptyprocess); fi
[ -z "${FORMCAD_PYI_ARCH:-}" ] || extra+=(--target-arch "$FORMCAD_PYI_ARCH")
[ ! -d "$FORMCAD_ROOT/setup/pyi_hooks" ] || extra+=(--additional-hooks-dir "$src/setup/pyi_hooks")
[ ! -d "$FORMCAD_ROOT/backend/app/data" ] || extra+=(--add-data "$src/backend/app/data${sep}app/data")
rm -rf build/pyinstaller dist-engine
PYTHONPATH="$src/backend${PYTHONPATH:+$sep$PYTHONPATH}" pyinstaller --noconfirm --clean --onedir --name formcad-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$src/frontend/dist${sep}frontend_dist" \
  --paths "$src/backend" --collect-submodules app --collect-submodules uvicorn --collect-submodules keyring \
  --hidden-import numpy --hidden-import ezdxf --hidden-import scipy.optimize --hidden-import scipy.spatial --hidden-import scipy.sparse.csgraph --hidden-import scipy.ndimage --hidden-import pyclipper --collect-submodules fontTools --collect-all skfem --collect-all uharfbuzz --hidden-import manifold3d --collect-all fast_simplification --collect-all blake3 --collect-all pypdfium2 --collect-all pypdfium2_raw --hidden-import sqlite3 --hidden-import mujoco --collect-binaries mujoco \
  "${extra[@]}" \
  "$src/backend/formcad_engine.py"
out="$FORMCAD_ROOT/src-tauri/engine"
rm -rf "$out"
cp -R dist-engine/formcad-engine "$out"
cp "$FORMCAD_ROOT/apps/form-app.json" "$out/form-app.json"
[ "$(fc_os)" != macos ] || flatten_engine "$out"
[ "$(fc_os)" != macos ] || sign_engine "$out"
"$out/formcad-engine${ext}" --selfcheck
fc_say "engine folder ready: $out"
