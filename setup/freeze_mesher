#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fc_mesher_venv
python -c "import PyInstaller" 2>/dev/null || pip install pyinstaller==6.22.3
cd "$FORMCAD_ROOT/mesher"
ext="$(fc_exe)"
src="$(fc_native_path "$FORMCAD_ROOT")"
sep=":"
[ "$(fc_os)" = windows ] && sep=";"
occt="$(python -c "import importlib.metadata as m; print(next(f for f in m.files('netgen-occt') if f.match('*TKernel*')).locate().resolve().parent)")"
[ -d "$occt" ] || fc_die "the OpenCascade libraries of netgen-occt were not found"
rm -rf build dist
pyinstaller --noconfirm --clean --onedir --name formcad-mesher \
  --distpath dist --workpath build --specpath build \
  --collect-all netgen --collect-all pyngcore \
  --add-binary "$(fc_native_path "$occt")/*TK*${sep}occt" \
  --exclude-module netgen.gui --exclude-module netgen.webgui --exclude-module tkinter \
  "$src/mesher/formcad_mesher.py"
bin="dist/formcad-mesher/formcad-mesher${ext}"
"$bin" --selfcheck || fc_die "the frozen mesher failed its selfcheck"
reply="$(printf '{"id":1,"method":"hello","params":{}}\n{"id":2,"method":"shutdown","params":{}}\n' | "$bin" | head -n 1)"
printf '%s\n' "$reply" | grep -q '"result"' || fc_die "the frozen mesher did not answer hello: $reply"
fc_say "mesher folder ready: $FORMCAD_ROOT/mesher/dist/formcad-mesher (ship it from formCAD-binaries, never inside the app)"
