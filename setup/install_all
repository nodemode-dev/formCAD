#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
lite=0
for arg in "$@"; do [ "$arg" = "--lite" ] && lite=1; done
fc_say "installing engine"
"$FORMCAD_ROOT/setup/install_backend"
if [ "$lite" = 1 ]; then
  fc_say "skipping the kernel dev venv (--lite): 2D features work without it"
else
  "$FORMCAD_ROOT/setup/install_kernel" || fc_say "kernel did not install; the app still runs its 2D features. Retry with ./formCAD install-kernel"
  "$FORMCAD_ROOT/setup/install_mesher" || fc_say "mesher did not install; simulation studies are unavailable. Retry with ./formCAD install-mesher"
fi
fc_say "installing frontend"
"$FORMCAD_ROOT/setup/install_frontend"
fc_say "done. Boot with ./formCAD"
